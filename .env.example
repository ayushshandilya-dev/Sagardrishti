# Sagar-Drishti API — deployment configuration
# Copy to `.env` (or provide these as environment variables on the host).

# --- Storage ----------------------------
# Default: local SQLite at ./data/sagar_drishti.db
# Production (Postgres):
# DATABASE_URL=postgresql+psycopg://sagar_user:password@localhost:5432/sagar_drishti
DATABASE_URL=sqlite:///./data/sagar_drishti.db

# Seed incidents/vessels/ledger on startup (idempotent).
AUTO_SEED=true

# --- CORS -------------------------------
# Comma separated. "*" for any origin (demo). Production:
# CORS_ORIGINS=https://sagar-drishti.vercel.app
CORS_ORIGINS=*

# --- Forensic custody -------------------
# Single ICG authority Ed25519 key (hex seed). Override in production.
NODE_SIGNING_KEY=0101010101010101010101010101010101010101010101010101010101010101

# --- Runtime ----------------------------
API_ENV=development

# --- External data providers -------------
# Leave blank to use bundled sample scenes and cached console data.
COPERNICUS_CDSE_CLIENT_ID=
COPERNICUS_CDSE_CLIENT_SECRET=
COPERNICUS_CDSE_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1

# AIS provider credentials. Configure exactly one provider in production.
AIS_PROVIDER=sample
AIS_API_KEY=
AIS_STREAM_URL=

# MetOcean providers for wind/current grids.
METOCEAN_PROVIDER=sample
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
ECMWF_API_KEY=

# --- Evidence export ---------------------
# Production should write generated dossiers/manifests to durable object storage.
EVIDENCE_EXPORT_DIR=./output/evidence
EVIDENCE_OBJECT_STORE_URL=
EVIDENCE_OBJECT_STORE_ACCESS_KEY=
EVIDENCE_OBJECT_STORE_SECRET_KEY=

# --- Security ----------------------------
# Comma-separated role names used by the API once authentication is enabled.
RBAC_ROLES=analyst,investigator,admin,legal_reviewer

# Set to true only after auth middleware protects export/signing endpoints.
ALLOW_PUBLIC_EVIDENCE_EXPORT=false
